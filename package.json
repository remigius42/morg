{
  "name": "@remigius42/morg",
  "version": "0.3.0",
  "description": "Bidirectional Markdown ↔ Org-mode converter with round-trip convergence",
  "keywords": [
    "org-mode",
    "markdown",
    "converter",
    "unified",
    "remark",
    "uniorg",
    "logseq",
    "obsidian"
  ],
  "license": "GPL-3.0-or-later",
  "author": "Andreas Remigius Schmidt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/remigius42/morg.git"
  },
  "bugs": "https://github.com/remigius42/morg/issues",
  "homepage": "https://github.com/remigius42/morg#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "morg": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "husky",
    "prepack": "npm run build",
    "build": "tsc -p tsconfig.build.json",
    "build:web": "vite build web",
    "dev:web": "vite web",
    "preview:web": "vite preview web --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "npm run lint:prettier && npm run lint:cspell && npm run lint:markdown && npm run lint:eslint && npm run lint:knip && npm run typecheck",
    "lint:knip": "knip",
    "lint:packaging": "attw --pack . --ignore-rules cjs-resolves-to-esm",
    "lint:prettier": "prettier --no-error-on-unmatched-pattern --ignore-unknown --list-different '**/*'",
    "lint:cspell": "cspell --dot --no-must-find-files --no-progress '**/*'",
    "lint:markdown": "markdownlint-cli2 '**/*.md' '!node_modules/**'",
    "lint:eslint": "eslint --max-warnings=0 '**/*.{ts,mts,js,mjs}'",
    "lint:fix": "npm run lint:fix:prettier && npm run lint:fix:eslint",
    "lint:fix:prettier": "prettier --write '**/*'",
    "lint:fix:eslint": "eslint --fix '**/*.{ts,mts,js}'",
    "test:unit": "vitest",
    "test:unit:ci": "vitest run --reporter default --coverage",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:report": "playwright show-report tests/e2e/reports/html"
  },
  "dependencies": {
    "@types/mdast": "^4.0.4",
    "orgast-util-to-string": "^1.1.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "smol-toml": "^1.8.0",
    "unified": "^11.0.5",
    "uniorg": "^1.4.0",
    "uniorg-parse": "^3.2.2",
    "uniorg-stringify": "^1.4.0",
    "unist-util-visit": "^5.0.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@picocss/pico": "^2.1.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.3.0",
    "@types/unist": "^3.0.3",
    "@vitest/coverage-v8": "^5.0.0",
    "cspell": "^10.2.2",
    "eslint": "^10.10.0",
    "happy-dom": "^20.14.3",
    "husky": "^9.1.7",
    "knip": "^6.35.1",
    "lint-staged": "^17.5.1",
    "markdownlint-cli2": "^0.23.2",
    "prettier": "^3.6.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
