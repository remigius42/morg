{
  "name": "morg",
  "version": "0.1.0",
  "description": "Bidirectional Markdown ↔ Org-mode converter with round-trip convergence",
  "keywords": [
    "org-mode",
    "markdown",
    "converter",
    "unified",
    "remark",
    "uniorg",
    "logseq",
    "obsidian"
  ],
  "license": "GPL-3.0-or-later",
  "author": "Andreas Remigius Schmidt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/remigius42/morg.git"
  },
  "bugs": "https://github.com/remigius42/morg/issues",
  "homepage": "https://github.com/remigius42/morg#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "morg": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "husky",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "npm run lint:prettier && npm run lint:cspell && npm run lint:markdown && npm run lint:eslint && npm run typecheck",
    "lint:prettier": "prettier --no-error-on-unmatched-pattern --ignore-unknown --list-different '**/*'",
    "lint:cspell": "cspell --dot --no-must-find-files --no-progress '**/*'",
    "lint:markdown": "markdownlint-cli2 '**/*.md' '!node_modules/**'",
    "lint:eslint": "eslint --max-warnings=0 '**/*.{ts,mts,js}'",
    "lint:fix": "npm run lint:fix:prettier && npm run lint:fix:eslint",
    "lint:fix:prettier": "prettier --write '**/*'",
    "lint:fix:eslint": "eslint --fix '**/*.{ts,mts,js}'",
    "test:unit": "vitest",
    "test:unit:ci": "vitest run --reporter default"
  },
  "dependencies": {
    "orgast-util-to-string": "^1.1.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "smol-toml": "^1.8.0",
    "unified": "^11.0.5",
    "uniorg": "^1.4.0",
    "uniorg-parse": "^3.2.2",
    "uniorg-stringify": "^1.4.0",
    "unist-util-visit": "^5.0.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.35.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.3.0",
    "@types/unist": "^3.0.3",
    "cspell": "^9.2.0",
    "eslint": "^9.35.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "markdownlint-cli2": "^0.18.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  }
}
