{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/index.ts",
    "src/cli.ts",
    "web/src/main.ts",
    "web/src/site.ts",
    "web/src/pipeline/worker.ts"
  ],
  "project": ["src/**/*.ts", "web/src/**/*.ts"],
  "vite": {
    "config": ["web/vite.config.ts"]
  },
  "playwright": {
    "config": ["playwright.config.ts"],
    // the specs' shared fixture and helpers are not spec files themselves,
    // and the plugin's default entry only covers the specs
    "entry": ["tests/e2e/**/*.ts"]
  },
  "ignoreDependencies": ["@picocss/pico"]
}
