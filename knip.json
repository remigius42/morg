{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/index.ts",
    "src/cli.ts",
    "web/src/main.ts",
    "web/src/site.ts",
    "web/src/licensesPage.ts",
    "web/src/pipeline/worker.ts"
  ],
  "project": ["src/**/*.ts", "web/src/**/*.ts", "scripts/*.mjs"],
  "vite": {
    "config": ["web/vite.config.ts"]
  },
  "playwright": {
    "config": ["playwright.config.ts"],
    // the specs' shared fixture and helpers are not spec files themselves,
    // and the plugin's default entry only covers the specs
    "entry": ["tests/e2e/**/*.ts"]
  },
  // reached from CSS (Pico) and through require.resolve (DejaVu's font
  // files, scripts/write-arrow-font.mjs), neither of which knip traces
  "ignoreDependencies": ["@picocss/pico", "dejavu-fonts-ttf"]
}
